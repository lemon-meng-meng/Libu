{
  "name": "libu-frontend",
  "productName": "吏部",
  "version": "0.4.0",
  "private": true,
  "description": "吏部 · 图片转电子文档（Electron + React）",
  "main": "electron/main.js",
  "author": "lemon-meng-meng",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "prepare-backend": "node -e \"require('fs').mkdirSync('backend',{recursive:true})\"",
    "electron:build": "npm run prepare-backend && vite build && electron-builder"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^31.7.0",
    "electron-builder": "^24.13.3",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "org.lemon.libu",
    "productName": "libu",
    "directories": {
      "output": "../../releases/electron",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "../../src", "to": "src", "filter": ["**/*.py"] },
      { "from": "dist", "to": "web", "filter": ["**/*"] },
      { "from": "backend", "to": "backend", "filter": ["**/*"] },
      { "from": "../../OCR Model", "to": "OCR Model", "filter": ["**/*"] }
    ],
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Graphics",
      "icon": "build/icon.png"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
