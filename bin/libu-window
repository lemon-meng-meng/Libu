#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
# 吏部 · Libu 原生窗口：用系统 WebKitGTK 将本地服务包装成独立桌面窗口。
# 该脚本使用系统 python3（需 python3-gi / gir1.2-webkit2-4.1），不依赖浏览器。
import os
import sys

# AppImage / 较旧内核下 WebKit 沙箱可能失败，关闭以保证窗口能正常启动
os.environ.setdefault("WEBKIT_DISABLE_SANDBOX_THIS_IS_DANGEROUS", "1")
os.environ.setdefault("WEBKIT_DISABLE_COMPOSITING_MODE", "1")


def main() -> int:
    url = sys.argv[1] if len(sys.argv) > 1 else "http://127.0.0.1:8756/"
    title = sys.argv[2] if len(sys.argv) > 2 else "吏部 · Libu"
    try:
        import gi

        gi.require_version("Gtk", "3.0")
        gi.require_version("WebKit2", "4.1")
        from gi.repository import Gtk, WebKit2
    except Exception:
        try:
            import gi

            gi.require_version("Gtk", "3.0")
            gi.require_version("WebKit2", "4.0")
            from gi.repository import Gtk, WebKit2
        except Exception as exc:  # noqa: BLE001
            print(f"无法创建原生窗口（缺少 WebKitGTK）：{exc}", file=sys.stderr)
            return 3

    win = Gtk.Window(title=title)
    win.set_default_size(1280, 820)
    here = os.path.dirname(os.path.abspath(__file__))
    icon = os.path.join(here, "..", "data", "icons", "libu_256.png")
    if os.path.exists(icon):
        try:
            win.set_icon_from_file(icon)
        except Exception:  # noqa: BLE001
            pass
    view = WebKit2.WebView()
    settings = view.get_settings()
    try:
        settings.set_property("enable-developer-extras", False)
        settings.set_property("enable-write-console-messages-to-stdout", False)
    except Exception:  # noqa: BLE001
        pass
    view.load_uri(url)
    win.add(view)
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main())
